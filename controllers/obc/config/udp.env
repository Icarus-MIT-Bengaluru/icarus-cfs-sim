# Phase 3 OBC-side UDP endpoint map.  Non-secret configuration only.
#
# This is the single OBC-side mapping of controller aliases, ports, message
# tokens, and timeouts.  Each controller's own config/runtime.env remains
# authoritative for that controller's identity and port; `run.sh phase 3`
# cross-checks the two and fails if they disagree, so this file can never
# silently drift out of step with the controllers it describes.

# Controller aliases on icarus-net, in probe order.
ICARUS_UDP_TARGETS="adcs payload comms"

# Alias -> port.  Must match controllers/<name>/config/runtime.env.
ICARUS_UDP_PORT_adcs=31001
ICARUS_UDP_PORT_payload=31002
ICARUS_UDP_PORT_comms=31003

# Protocol constants shared by the probe and the controller echo server.
ICARUS_UDP_REQUEST_PREFIX="ICARUS|HELLO|"
ICARUS_UDP_RESPONSE_PREFIX="ICARUS|ACK|"

# Test message token prefix; run.sh appends a per-run unique suffix so each
# exchange is individually matchable across both logs.
ICARUS_UDP_TOKEN_PREFIX=phase3

# Bounded wait for an acknowledgement, in seconds.
ICARUS_UDP_TIMEOUT_SECONDS=3
