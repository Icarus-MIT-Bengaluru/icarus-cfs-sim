# OBC container settings.  Do not put secrets in this file.
OBC_CONTAINER_NAME=icarus-obc
OBC_IMAGE=icarus-cfs-obc:dev
# Generous on purpose. cFE boots in well under a second by its own clock, but
# the OPERATIONAL line has taken 19s, 25s and 47s to become VISIBLE in the log
# on identical restarts. The cause is OSAL's asynchronous console
# (OSAL_CONFIG_CONSOLE_ASYNC defaults TRUE): OS_printf queues into a ring that
# a separate task drains, so output arrives in bursts. The delay is in log
# delivery, not in cFE. A 45s budget made the gates flaky.
OBC_STARTUP_TIMEOUT_SECONDS=120
CFS_VERSION=v7.0.1
ICARUS_NETWORK_NAME=icarus-net
